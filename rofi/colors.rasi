* {
    bg:             #11161D;
    bg-highlight:   #253240;
    fg:             #E5EDF5;
    muted:          #8FA1B2;
    teal:           #88C0D0;
    teal-bright:    #B5E3EC;
    border-color:   #344555;
    inactive:       #253240;
    red:            #BF616A;
    background:     @bg;
    background-alt: @bg-highlight;
    foreground:     @fg;
    selected:       @teal;
    active:         @teal-bright;
    urgent:         @red;
    border:         @border-color;
}
