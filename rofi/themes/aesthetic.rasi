/**
 * Modern & Aesthetic Rofi Theme
 * Designed for a deep teal/cyan palette matching the desktop theme.
 **/

* {
    /* Color Palette */
    bg-color:            rgba(16, 19, 25, 0.95);
    bg-alt:              #171b24;
    fg-color:            #f4f3ee;
    fg-alt:              #7d84ae;
    accent-color:        #3B9797;
    accent-highlight:    #62DFC1;
    border-color:        #3A435A;

    /* Global Rofi properties */
    background-color:    transparent;
    text-color:          @fg-color;
    margin:              0px;
    padding:             0px;
    spacing:             0px;
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    width:               640px;
    height:              480px;
    x-offset:            0px;
    y-offset:            0px;

    enabled:             true;
    border-radius:       16px;
    border:              2px solid;
    border-color:        @accent-color;
    background-color:    @bg-color;
    padding:             24px;
}

mainbox {
    enabled:             true;
    spacing:             20px;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    enabled:             true;
    spacing:             12px;
    padding:             12px 16px;
    border-radius:       10px;
    background-color:    @bg-alt;
    border:              1px solid;
    border-color:        @border-color;
    text-color:          @fg-color;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    text-color:          @accent-highlight;
    font:                "JetBrains Mono Bold 12";
}

entry {
    enabled:             true;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              text;
    placeholder:         "Search applications...";
    placeholder-color:   @fg-alt;
}

listview {
    enabled:             true;
    columns:             1;
    lines:               7;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    reverse:             false;
    fixed-height:        true;
    fixed-columns:       true;
    
    spacing:             8px;
    background-color:    transparent;
    text-color:          @fg-color;
    cursor:              "default";
}

element {
    enabled:             true;
    spacing:             12px;
    padding:             10px 14px;
    border-radius:       8px;
    background-color:    transparent;
    text-color:          @fg-color;
    cursor:              pointer;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @fg-color;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @fg-color;
}

element normal.urgent, element alternate.urgent {
    background-color:    #E34F4F;
    text-color:          #101319;
}

element normal.active, element alternate.active {
    background-color:    @accent-color;
    text-color:          @fg-color;
}

element selected.normal {
    background-color:    @bg-alt;
    border:              1px solid;
    border-color:        @accent-color;
    text-color:          @accent-highlight;
}

element selected.urgent {
    background-color:    #E34F4F;
    text-color:          @fg-color;
}

element selected.active {
    background-color:    @bg-alt;
    border:              1px solid;
    border-color:        @accent-highlight;
    text-color:          @accent-highlight;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                28px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}
