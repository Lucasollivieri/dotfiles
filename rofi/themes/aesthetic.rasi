/**
 * Cyberpunk Minimalist Premium Theme for Rofi
 * Inspired by Arch Linux, Hyprland & Cybersecurity / Cyberpunk Minimalist Concept.
 */

configuration {
    font:                "JetBrainsMono Nerd Font 11";
    drun-display-format: "<span font='JetBrainsMono Nerd Font SemiBold 11'>{name}</span>\n[<span font='JetBrainsMono Nerd Font Italic 9.5' foreground='#9AA5B1'>({generic})</span>]";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
}

* {
    /* Colors */
    bg-color:            rgba(6, 10, 15, 0.88);
    surface-color:       rgba(8, 12, 18, 0.92);
    primary-color:       #1793D1;
    accent-color:        #00D9FF;
    hover-color:         rgba(23, 147, 209, 0.08);
    selected-color:      rgba(0, 217, 255, 0.18);
    border-color-glow:   rgba(23, 147, 209, 0.55);
    text-primary:        #F5F7FA;
    text-secondary:      #9AA5B1;

    /* Fonts & Typography */
    font:                "JetBrainsMono Nerd Font 11";
    background-color:    transparent;
    text-color:          @text-primary;
    margin:              0px;
    padding:             0px;
    spacing:             0px;
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    width:               760px;
    x-offset:            0px;
    y-offset:            0px;

    enabled:             true;
    border-radius:       14px;
    border:              1px solid;
    border-color:        @border-color-glow;
    background-color:    @bg-color;
    padding:             18px;
}

mainbox {
    enabled:             true;
    spacing:             16px;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    enabled:             true;
    spacing:             10px;
    padding:             10px 16px;
    border-radius:       12px;
    background-color:    @surface-color;
    border:              0px 0px 2px 0px;
    border-color:        @primary-color;
    text-color:          @text-primary;
    children:            [ 
        "textbox-search-icon", 
        "textbox-search-apps", 
        "textbox-separator", 
        "textbox-arch-logo", 
        "textbox-arch-rofi", 
        "entry"
    ];
}

textbox-search-icon {
    str:            "";
    expand:         false;
    text-color:     @text-secondary;
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font 12";
}

textbox-search-apps {
    str:            "Search Applications...";
    expand:         false;
    text-color:     @text-secondary;
    vertical-align: 0.5;
}

textbox-separator {
    str:            "|";
    expand:         false;
    text-color:     rgba(23, 147, 209, 0.30);
    vertical-align: 0.5;
}

textbox-arch-logo {
    str:            "";
    expand:         false;
    text-color:     @primary-color;
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font 12";
}

textbox-arch-rofi {
    str:            "Arch Rofi";
    expand:         false;
    text-color:     @text-primary;
    vertical-align: 0.5;
    font:           "JetBrainsMono Nerd Font Bold 11";
}

entry {
    enabled:             true;
    background-color:    transparent;
    text-color:          @text-primary;
    cursor:              text;
    cursor-color:        @primary-color;
    placeholder:         "";
    placeholder-color:   @text-secondary;
    vertical-align:      0.5;
}

listview {
    enabled:             true;
    columns:             1;
    lines:               6;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    reverse:             false;
    fixed-height:        false;
    fixed-columns:       true;
    
    spacing:             6px;
    background-color:    transparent;
    text-color:          @text-primary;
    cursor:              "default";
}

element {
    enabled:             true;
    spacing:             14px;
    padding:             8px 16px;
    border-radius:       12px;
    background-color:    transparent;
    text-color:          @text-primary;
    cursor:              pointer;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @text-primary;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @text-primary;
}

element normal.urgent, element alternate.urgent {
    background-color:    #E34F4F;
    text-color:          #101319;
}

element normal.active, element alternate.active {
    background-color:    @surface-color;
    text-color:          @text-primary;
}

element selected.normal {
    background-color:    @selected-color;
    border:              0px 0px 0px 4px;
    border-color:        @accent-color;
    text-color:          @text-primary;
}

element selected.urgent {
    background-color:    #E34F4F;
    text-color:          @text-primary;
}

element selected.active {
    background-color:    @selected-color;
    border:              0px 0px 0px 4px;
    border-color:        @accent-color;
    text-color:          @text-primary;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                32px;
    cursor:              inherit;
    vertical-align:      0.5;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
    markup:              true;
}
