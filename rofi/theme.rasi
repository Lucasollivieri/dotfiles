configuration {
    modi: "drun,run,window,filebrowser";
    display-drun: "";
    display-run: "";
    display-window: "";
    display-filebrowser: "";
    drun-display-format: "{name}";
    window-format: "{w}  ·  {c}";
}

@import "~/.config/rofi/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @foreground;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 720px;
    border: 1px;
    border-color: @border;
    border-radius: 18px;
    background-color: @bg;
    padding: 16px;
}

mainbox { spacing: 12px; children: [ inputbar, listbox ]; }

inputbar {
    spacing: 10px;
    padding: 12px 14px;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    background-color: @background-alt;
    children: [ prompt, entry ];
}

prompt { text-color: @teal-bright; padding: 0 4px; }
entry {
    expand: true;
    placeholder: "Search applications, commands or windows";
    placeholder-color: @muted;
    text-color: @foreground;
}

listbox { spacing: 8px; children: [ message, listview ]; }
message { padding: 4px 8px; text-color: @muted; }
listview {
    columns: 1;
    lines: 7;
    spacing: 5px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 10px;
    background-color: transparent;
}
element selected.normal { background-color: @selected; text-color: @bg; }
element normal.active { background-color: @background-alt; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 28px; }

mode-switcher { spacing: 6px; }
mode-switcher button {
    padding: 7px 10px;
    border-radius: 8px;
    background-color: @background-alt;
    text-color: @muted;
}
mode-switcher button selected { background-color: @teal; text-color: @bg; }
