{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 430,
  "control-center-margin-top": 14,
  "control-center-margin-bottom": 14,
  "control-center-margin-right": 14,
  "control-center-margin-left": 14,
  "notification-2fa-action": false,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "notification-visibility": {
    "system-security-app": {"state": "enabled", "override-urgency": "critical", "app-name": "(?i)system|sistema|networkmanager|gufw|firewall|polkit|security|segurança|auth|login|sudo|ssh|keyring|gpg|hyprland|sway"},
    "system-security-summary": {"state": "enabled", "override-urgency": "critical", "summary": "(?i)system|sistema|security|segurança|auth|login|sudo|ssh|keyring|gpg|alerta|alert|erro|error|danger|perigo|critical"},
    "updates-app": {"state": "enabled", "override-urgency": "low", "app-name": "(?i)update|updates|atualiz|pacman|yay|apt|dnf|upgrade"},
    "updates-summary": {"state": "enabled", "override-urgency": "low", "summary": "(?i)update|updates|atualiz|upgrade"}
  },
  "notification-window-width": 430,
  "notification-icon-size": 40,
  "notification-body-image-height": 180,
  "notification-body-image-width": 220,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 220,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "label#header",
    "buttons-grid#power-actions",
    "volume",
    "buttons-grid#audio-actions",
    "buttons-grid#quick-actions",
    "buttons-grid#sysinfo-grid",
    "mpris",
    "title#notifications",
    "notifications"
  ],
  "widget-config": {
    "label#header": {"max-lines": 3, "text": "󰀄  Loading user@host…\n󰥔  Uptime: loading  ·  Updates: --"},
    "buttons-grid#power-actions": {
      "buttons-per-row": 4,
      "actions": [
        {"label": "󰌾\nLock", "command": "loginctl lock-session"},
        {"label": "󰍃\nLogout", "command": "hyprctl dispatch exit"},
        {"label": "󰐥\nPower", "command": "systemctl poweroff"},
        {"label": "󰗼\nTheme", "command": "$HOME/.dotfiles/theme-selector.sh"}
      ]
    },
    "volume": {"label": "󰕾", "show-per-app": false},
    "buttons-grid#audio-actions": {
      "buttons-per-row": 2,
      "actions": [
        {"label": "󰍬  Microphone", "type": "toggle", "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true'"},
        {"label": "󰓃  Mixer", "command": "pavucontrol"}
      ]
    },
    "buttons-grid#quick-actions": {
      "buttons-per-row": 4,
      "actions": [
        {"label": "󰖩\nWi-Fi", "command": "nm-connection-editor", "type": "toggle", "active": true},
        {"label": "󰂯\nBluetooth", "command": "$HOME/.config/swaync/toggle_bluetooth.sh", "type": "toggle", "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: no\" && echo true || echo false'"},
        {"label": "󰌾\nVPN", "command": "sh -c 'flatpak run com.protonvpn.www &'", "type": "toggle", "update-command": "sh -c 'nmcli connection show --active 2>/dev/null | grep -qiE \"proton|pvpn\" && echo true || echo false'"},
        {"label": "󰍜\nDND", "command": "swaync-client -d", "update-command": "swaync-client -D", "type": "toggle"},
        {"label": "󰖔\nNight", "command": "notify-send 'Night mode' 'hyprshade is not installed' -t 2500"},
        {"label": "󰒓\nSettings", "command": "nwg-look"},
        {"label": "󰍬\nMic", "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "type": "toggle", "update-command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true'"},
        {"label": "󰗼\nNetwork", "command": "nm-connection-editor"}
      ]
    },
    "buttons-grid#sysinfo-grid": {
      "buttons-per-row": 4,
      "actions": [
        {"label": "CPU\n--", "command": "true"},
        {"label": "RAM\n--", "command": "true"},
        {"label": "DISK\n--", "command": "true"},
        {"label": "NET\n--", "command": "true"}
      ]
    },
    "title#notifications": {"text": "Notifications", "clear-all-button": true, "button-text": "󰎟  Clear all"},
    "mpris": {"image-size": 76, "image-radius": 10}
  }
}
