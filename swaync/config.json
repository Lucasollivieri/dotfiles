{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 460,
  "control-center-margin-top": 15,
  "control-center-margin-bottom": 15,
  "control-center-margin-right": 15,
  "control-center-margin-left": 15,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-window-width": 460,
  "notification-icon-size": 48,
  "notification-body-image-height": 240,
  "notification-body-image-width": 240,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "label#clock",
    "label#date",
    "label#header-system",
    "volume",
    "backlight",
    "buttons-grid#system",
    "label#header-indicators",
    "buttons-grid#indicators",
    "mpris",
    "notifications",
    "calendar"
  ],
  "widget-config": {
    "title": {
      "text": "Central de Controle",
      "clear-all-button": true,
      "button-text": "󰎟 Limpar"
    },
    "label#clock": {
      "max-lines": 1,
      "text": "19:04"
    },
    "label#date": {
      "max-lines": 1,
      "text": "Friday, June 26"
    },
    "label#header-system": {
      "max-lines": 1,
      "text": "Status do Sistema"
    },
    "label#header-indicators": {
      "max-lines": 1,
      "text": "Indicadores"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid#system": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰖩  Internet\nConnected",
          "command": "nm-connection-editor",
          "type": "toggle"
        },
        {
          "label": "󰖔  Night Light\nActive",
          "command": "hyprshade toggle night-light",
          "type": "toggle"
        },
        {
          "label": "󰍜  Do Not Disturb\nOn",
          "command": "swaync-client -d",
          "update-command": "swaync-client -D",
          "type": "toggle"
        },
        {
          "label": "󰏘  Theme\nDark",
          "command": "nwg-look",
          "type": "toggle",
          "active": true
        },
        {
          "label": "  Settings\nSystem",
          "command": "kitty bash -i -c 'Settings'",
          "type": "toggle"
        }
      ]
    },
    "buttons-grid#indicators": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖂  VPN",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰍬  Mic",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        {
          "label": "󰖠  Webcam",
          "command": "echo 'Toggle Webcam'"
        },
        {
          "label": "󰻃  Rec",
          "command": "echo 'Toggle Recording'"
        },
        {
          "label": "󰂯  Bluetooth",
          "command": "blueman-manager"
        },
        {
          "label": "󰁹  Bateria",
          "command": "upower -i $(upower -e | grep battery)"
        }
      ]
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    }
  }
}
