{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 460,
  "control-center-margin-top": 15,
  "control-center-margin-bottom": 15,
  "control-center-margin-right": 15,
  "control-center-margin-left": 15,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-window-width": 460,
  "notification-icon-size": 48,
  "notification-body-image-height": 240,
  "notification-body-image-width": 240,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "label#clock",
    "label#date",
    "buttons-grid",
    "buttons-grid#tabs",
    "mpris",
    "notifications",
    "calendar"
  ],
  "widget-config": {
    "label#clock": {
      "max-lines": 1,
      "text": "14:12"
    },
    "label#date": {
      "max-lines": 1,
      "text": "Friday, June 26"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰖩  Internet\nConnected",
          "command": "nm-connection-editor",
          "type": "toggle"
        },
        {
          "label": "󰂯  Bluetooth\nEnabled",
          "command": "blueman-manager",
          "type": "toggle",
          "active": true
        },
        {
          "label": "󰖔  Night Light\nActive",
          "command": "hyprshade toggle night-light",
          "type": "toggle"
        },
        {
          "label": "󰍜  Do Not Disturb\nOn",
          "command": "swaync-client -d",
          "update-command": "swaync-client -D",
          "type": "toggle"
        },
        {
          "label": "󰏘  Theme\nDark",
          "command": "nwg-look",
          "type": "toggle",
          "active": true
        },
        {
          "label": "  Settings\nSystem",
          "command": "kitty bash -i -c 'Settings'",
          "type": "toggle"
        }
      ]
    },
    "buttons-grid#tabs": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "Notifications",
          "command": ""
        },
        {
          "label": "Audio",
          "command": "pavucontrol-qt"
        }
      ]
    },
    "mpris": {
      "image-size": 96,
      "image-radius": 12
    }
  }
}
